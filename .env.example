TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
SOCKS5_PROXY=

# Proxy for Selectel/OpenStack API requests.
# If empty, direct connection is used.
# If OPENSTACK_PROXY is empty but OPENSTACK_PROXY_FALLBACK_TO_SOCKS5_PROXY=true,
# SOCKS5_PROXY will be reused.
OPENSTACK_PROXY=
OPENSTACK_PROXY_FALLBACK_TO_SOCKS5_PROXY=true

# Optional no-proxy list for local/internal requests.
OPENSTACK_NO_PROXY=127.0.0.1,localhost

OS_AUTH_URL=https://cloud.api.selcloud.ru/identity/v3
OS_PROJECT_ID=
OS_PROJECT_NAME=
OS_USERNAME=
OS_PASSWORD=
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=ru-1
OS_INTERFACE=public
OS_IDENTITY_API_VERSION=3
OS_COMPUTE_API_VERSION=2.72

# =========================
# SWIFTSHIELD WATCHDOG
# =========================
# Runs outside SwiftShield1, checks the preemptible server, and restores it.
SWIFTSHIELD_ENABLED=false
SWIFTSHIELD_REGION=ru-3
SWIFTSHIELD_AVAILABILITY_ZONE=
SWIFTSHIELD_SERVER_ID=223a6632-2fba-456b-b8c7-24b3786c320a
SWIFTSHIELD_SERVER_NAME=SwiftShield1
SWIFTSHIELD_WAIT_SECONDS=300
SWIFTSHIELD_DRY_RUN=false
SWIFTSHIELD_NOTIFY_TELEGRAM=true
SWIFTSHIELD_NOTIFY_ALWAYS=false
SWIFTSHIELD_NOTIFY_REPEAT_SECONDS=3600
SWIFTSHIELD_STATE_FILE=/opt/selectel-finder/swiftshield_watchdog_state.json

TARGET_COUNT=11
REGIONS=ru-1,ru-2,ru-3,ru-6,ru-7,ru-8,ru-9
GOOD_IP_SYNC_INTERVAL=300
WHITELIST_MAX_BYTES=1048576

# If Selectel returns multiple external networks in a region, set one of these.
FLOATING_NETWORK_ID=
FLOATING_NETWORK_NAME=

# Optional per-region overrides. Use region suffixes with "-" replaced by "_".
# FLOATING_NETWORK_ID_RU_1=
# FLOATING_NETWORK_NAME_RU_1=

PROVISION_ENABLED=false
PROVISION_ORIGIN_IP=
PROVISION_VLESS_TEMPLATE='vless://UUID@{WHITE_IP}:443?type=tcp&encryption=none&security=reality&pbk=PUBLIC_KEY&fp=chrome&sni=example.com&sid=SID&spx=%2F&flow=xtls-rprx-vision#user'
PROVISION_PREEMPTIBLE_REGIONS=ru-1,ru-3,ru-7,ru-8
PROVISION_ALLOW_NON_PREEMPTIBLE=false
PROVISION_SERVER_NAME_PREFIX=selectel-finder
PROVISION_IMAGE_ID=
PROVISION_IMAGE_NAME='Ubuntu 24.04 LTS 64-bit'
PROVISION_FLAVOR_ID=
PROVISION_FLAVOR_NAME=
PROVISION_REQUIRE_LOCAL_DISK=true
PROVISION_NETWORK_ID=
PROVISION_NETWORK_NAME=
PROVISION_SECURITY_GROUP=selectel-finder-proxy
PROVISION_KEY_NAME=
PROVISION_AVAILABILITY_ZONE=
PROVISION_AUTO_FLAVOR_FALLBACK=true
PROVISION_MAX_FLAVOR_ATTEMPTS=10
PROVISION_SERVER_WAIT_SECONDS=300
PROVISION_SETUP_WAIT_SECONDS=120
PROVISION_TCP_CHECK_ENABLED=true
PROVISION_TCP_CHECK_TIMEOUT=5
PROVISION_TCP_CHECK_RETRIES=6
PROVISION_DECISION_TIMEOUT=300
PROVISION_DELETE_SERVER_AFTER_RESULT=true
PROVISION_DELETE_FAILED_FLOATING_IP=true

# =========================
# VLESS AUTO-TESTER API
# =========================
TESTER_API_ENABLED=true
TESTER_API_HOST=0.0.0.0
TESTER_API_PORT=8787
TESTER_TOKEN=
TESTER_BATCH_SIZE=11
TESTER_LEASE_SECONDS=900
TESTER_MAX_ATTEMPTS=2
VLESS_QUEUE_DB=/opt/selectel-finder/vless_tests.sqlite3

# =========================
# WEB DASHBOARD
# =========================
DASHBOARD_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
DASHBOARD_LOG_LINES=200

# Termux/Redmi tester behavior
# any: accept any successful curl through test VLESS (recommended for forwarding/frontend mode)
# candidate: require api.ipify.org == candidate IP (old strict mode)
# exact: require api.ipify.org == EXPECTED_EXIT_IP
TESTER_EXPECT_EXIT_IP=any
EXPECTED_EXIT_IP=
RAW_TCP_CHECK_ENABLED=true
RAW_TCP_CHECK_TIMEOUT=8
