[Unit]
Description=SwiftShield preemptible server watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=finder
Group=finder
WorkingDirectory=/opt/selectel-finder
EnvironmentFile=/opt/selectel-finder/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/selectel-finder/.venv/bin/python /opt/selectel-finder/swiftshield_watchdog.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/selectel-finder
